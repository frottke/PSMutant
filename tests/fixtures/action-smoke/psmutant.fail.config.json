{
  "sandboxSubtrees": [
    "src",
    "tests"
  ],
  "mutate": [
    "src/calc.ps1"
  ],
  "tests": {
    "src/calc.ps1": [
      "tests/calc.Tests.ps1"
    ]
  },
  "coveredLinesOnly": true,
  "operators": [
    "BinaryOperator",
    "BooleanLiteral"
  ],
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 100
  },
  "reportPath": "reports/action-smoke-fail.json"
}
